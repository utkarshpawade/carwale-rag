# Copy to .env (never commit .env) and fill in.
GROQ_API_KEY=gsk_your_key_here

# Local dev DB (docker run ... pgvector/pgvector:pg17 on port 5433). For Neon use the *pooled* URL in the app
# and the *direct* URL when running `python -m ingestion.load_db`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/carwale

# Optional overrides (comma-separated fallback chains, first = primary)
# PLANNER_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,llama-3.1-8b-instant
# ANSWER_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
# SUMMARY_MODELS=llama-3.1-8b-instant,openai/gpt-oss-20b
# FORCE_FAIL_MODELS=openai/gpt-oss-120b      # demo the fallback chain
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
